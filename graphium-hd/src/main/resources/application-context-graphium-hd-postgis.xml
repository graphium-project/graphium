<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- override ResultSetExtractor -->
    <bean id="hdWaySegmentResultSetExtractor" class="at.srfg.graphium.postgis.persistence.resultsetextractors.HDWaySegmentResultSetExtractor"/>    

    <bean id="hdSegmentResultSetExtractorFactory" class="at.srfg.graphium.postgis.persistence.resultsetextractors.impl.SegmentResultSetExtractorFactoryImpl">
    	<lookup-method bean="hdWaySegmentResultSetExtractor" name="createResultSetExtractor"/>
    	<property name="xInfoRowMapperFactory" ref="segmentXInfoRowMapperFactory"/>
    </bean>

    <bean id="hdAreaRowMapper" class="at.srfg.graphium.postgis.persistence.rowmapper.HDAreaRowMapper" />
    <bean id="hdInfraAndSignsRowMapper" class="at.srfg.graphium.postgis.persistence.rowmapper.HDInfraAndSignsRowMapper" />

    <bean id="postgisHDWayGraphWriteDao" class="at.srfg.graphium.postgis.persistence.impl.HDWayGraphWriteDaoImpl" parent="graphiumAbstractPostgisDao">
    	<property name="xInfoDaoRegistry" ref="xInfoDaoRegistry"/>
    	<property name="metadataDao" ref="postgisWayGraphVersionMetadataDao"/>
    </bean>
    
    <bean id="postgisHDWayGraphReadDao" class="at.srfg.graphium.postgis.persistence.impl.WayGraphReadDaoImpl" parent="graphiumAbstractPostgisDao">
    	<property name="viewDao" ref="wayGraphViewDao"/>
    	<property name="resultSetExtractorFactory" ref="hdSegmentResultSetExtractorFactory"/>
    </bean>
    
    <bean id="postgisHDWayGraphViewDao" class="at.srfg.graphium.postgis.persistence.impl.HDWayGraphViewDaoImpl" parent="graphiumAbstractPostgisDao">
    	<property name="rowMapper" ref="wayGraphViewRowMapper"/>
        <property name="areaRowMapper" ref="hdAreaRowMapper" />
        <property name="infraAndSignsRowMapper" ref="hdInfraAndSignsRowMapper" />
    	<property name="waySegmentRowMapper" ref="waySegmentResultSetExtractor"/>
    </bean>

    <bean id="postgisHDWayGraphAdditionalElementsWriteDao"
          class="at.srfg.graphium.postgis.persistence.impl.HDWayGraphAdditionalElementsWriteDaoImpl" parent="graphiumAbstractPostgisDao">
        <property name="metadataDao" ref="postgisWayGraphVersionMetadataDao"/>
    </bean>

    <bean id="postgisHDWayGraphAdditionalElementsReadDao" class="at.srfg.graphium.postgis.persistence.impl.HDWayGraphAdditionalElementsReadDaoImpl"
          parent="graphiumAbstractPostgisDao">
        <property name="viewDao" ref="wayGraphViewDao"/>
        <property name="areaRowMapper" ref="hdAreaRowMapper"/>
        <property name="infraAndSignsRowMapper" ref="hdInfraAndSignsRowMapper"/>
    </bean>

    <bean id="hdRegulatoryElementXinfoDao" parent="graphiumAbstractPostgisDao"
          class="at.srfg.graphium.postgis.persistence.impl.HDRegulatoryElementXinfoDao" >
        <property name="viewDao" ref="wayGraphViewDao"/>
        <property name="metadataDao" ref="postgisWayGraphVersionMetadataDao"/>
    </bean>

    
    <alias name="postgisHDWayGraphReadDao" alias="hdWayGraphReadDao"/>
    <alias name="postgisHDWayGraphWriteDao" alias="hdWayGraphWriteDao"/>
    <alias name="postgisHDWayGraphAdditionalElementsReadDao" alias="hdWayGraphAdditionalElementsReadDao"/>
    <alias name="postgisHDWayGraphAdditionalElementsWriteDao" alias="hdWayGraphAdditionalElementsWriteDao"/>
 	<alias name="postgisQueuingHDGraphVersionImportService" alias="queuingHDGraphVersionImportService"/>

</beans>