<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
		http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="hdWaySegment2SegmentDTOAdapter"
          class="at.srfg.graphium.io.adapter.impl.HDWaySegment2HDWaySegmentDTOAdapter"
          parent="abstractSegmentDTOAdapter"/>

    <bean id="hdArea2HDAreaDTOAdapter" class="at.srfg.graphium.io.adapter.impl.HDArea2HDAreaDTOAdapter"/>
    <bean id="hdRoadInfrastructure2HDRoadInfrastructureDTOAdapter"
          class="at.srfg.graphium.io.adapter.impl.HDRoadInfrastructure2HDRoadInfrastructureDTOAdapter"/>

    <bean id="jacksonQueuingHdGraphInputFormat"
          class="at.srfg.graphium.io.inputformat.hd.impl.jackson.GenericQueuingJacksonHdWayGraphInputFormat">
        <constructor-arg name="adapterRegistry" ref="autodetectingSegmentAdapterRegistry"/>
        <property name="metadataAdapter" ref="graphVersionMetadataDTO2GraphVersionMetadataAdapter"/>
    </bean>

    <bean id="hdRegulatoryElementXInfoAdapter"
          class="at.srfg.graphium.io.adapter.impl.HDRegulatoryElementXInfoAdapter" />
</beans>