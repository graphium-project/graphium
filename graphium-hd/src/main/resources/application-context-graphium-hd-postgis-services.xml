<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
	
    <!--<bean id="postgisQueuingHDGraphVersionImportService" class="at.srfg.graphium.core.service.impl.QueuingGraphVersionImportServiceImpl">-->
	<bean id="postgisQueuingHDGraphVersionImportService" class="at.srfg.graphium.core.service.impl.QueuingHDGraphVersionImportServiceImpl">
    	<property name="metadataDao" ref="wayGraphVersionMetadataDao"/>
<!--    	<property name="inputFormat" ref="jacksonQueuingGraphInputFormat"/>-->
		<property name="inputFormat" ref="jacksonQueuingHdGraphInputFormat" />
    	<property name="segmentAdpaterRegistry" ref="autodetectingSegmentAdapterRegistry"/>
    	<property name="queueSize" value="${graphium.import.queueSize}"/>
    	<property name="batchSize" value="${graphium.import.batchSize}"/>
    	<property name="sourceDao" ref="wayGraphSourceDao"/>
    	<property name="writeDao" ref="postgisHDWayGraphWriteDao"/>
    	<property name="serverStatus" ref="serverStatus"/>
    	<property name="viewDao" ref="postgisHDWayGraphViewDao"/>
    	<property name="validityPeriodValidator" ref="graphVersionValidityPeriodValidator"/>
		<property name="additionalElementsWriteDao" ref="hdWayGraphAdditionalElementsWriteDao"/>
    </bean>
 
</beans>