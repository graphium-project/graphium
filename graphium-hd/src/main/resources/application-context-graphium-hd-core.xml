<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    	
    <bean id="hdWayGraphModelFactory" class="at.srfg.graphium.model.hd.impl.HDWayGraphModelFactory" />
	
	<bean id="hdCapability" class="at.srfg.graphium.core.capabilities.impl.GraphiumHdCapabilityImpl"/>
    
	<!-- services -->
	<bean id="hdGraphReadService" 
		class="at.srfg.graphium.core.service.impl.GraphReadServiceImpl">
		<property name="readDao" ref="hdWayGraphReadDao"/>
	</bean>
	
	<bean id="hdGraphWriteService" 
		class="at.srfg.graphium.core.service.impl.GraphWriteServiceImpl">
		<property name="graphWriteDao" ref="hdWayGraphWriteDao"/>
		<property name="metadataDao" ref="wayGraphVersionMetadataDao"/>
	</bean>

</beans>